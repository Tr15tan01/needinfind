# --- Database (Supabase Postgres, used by Prisma) ---------------------------
# These are POSTGRES connection strings, not the API keys below — get them
# from Project Settings -> Database -> Connection string (NOT the API page).
#
# DATABASE_URL: the pooled "Transaction" connection (port 6543, via PgBouncer)
# — used for normal app query traffic. Needs pgbouncer=true so Prisma
# disables prepared statements, which PgBouncer transaction mode can't handle.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: the direct connection (port 5432, no pooler) — required by
# `prisma migrate` / `prisma db push`, which can't run through PgBouncer.
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# --- Auth.js ------------------------------------------------------------------
AUTH_SECRET="generate-with: npx auth secret"
AUTH_URL="http://localhost:3000"

# Google OAuth — customer sign-in (Phase 4). Admin login (also Phase 2) uses
# email+password via Auth.js Credentials against the User table instead,
# independent of this and of Supabase Auth. Get these from Google Cloud
# Console -> APIs & Services -> Credentials -> OAuth client ID (Web
# application), with an authorized redirect URI of
# <AUTH_URL>/api/auth/callback/google (e.g. http://localhost:3000/api/auth/callback/google).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Supabase API (from Project Settings -> API — this is where your two
# values came from). Only needed once something uses supabase-js directly,
# e.g. Supabase Storage for product images. Prisma/the database layer above
# doesn't use these at all. Supabase's newer key system calls these
# "publishable" (safe in the browser) and "secret" (server-only, replaces
# the old service_role key) instead of "anon" / "service_role".
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""

# --- AI (Gemini) ----------------------------------------------------------
# Server-side only. Never exposed to the client. Used by the assistant
# (Phase 5) for structured requirement extraction and grounded explanations.
GEMINI_API_KEY=""
# Optional — defaults to gemini-flash-latest if unset. gemini-1.5-flash and
# gemini-2.0-flash are end-of-life; if you want to pin a specific version
# instead of the rolling "latest" alias, check ai.google.dev/docs/changelog
# for what's currently available before setting this.
GEMINI_MODEL=""

# --- Public site ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Payments (Stripe) ------------------------------------------------------
# Server-side only. Used by Phase 10 for paid PricingPlan checkout.
# Get these from the Stripe Dashboard -> Developers -> API keys / Webhooks.
STRIPE_SECRET_KEY=""
# From the webhook endpoint you create pointing at
# <NEXT_PUBLIC_SITE_URL>/api/webhooks/stripe — needed to verify that
# webhook requests actually came from Stripe.
STRIPE_WEBHOOK_SECRET=""
